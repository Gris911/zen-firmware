#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29 11>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC           &kp Q         &kp W         &kp E      &kp R   &kp T  &kp Y      &kp U          &kp I      &kp O           &kp P                 &kp DEL
&kp TAB           &kp A         &kp S         &kp D      &kp F   &kp G  &kp H      &kp J          &kp K      &kp L           &kp SEMI              &kp ENTER
&kp LSHFT         &kp Z         &kp X         &kp C      &kp V   &kp B  &mo 2      &mo 1          &kp N      &kp M           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UP_ARROW  &mt RSHFT MINUS
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_WIN  &kp LANG2  &trans  &mo 1  &kp SPACE  &kp BACKSPACE  &kp LANG1  &kp LEFT_ARROW  &kp DOWN_ARROW        &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL        &kp MINUS     &kp PAGE_UP    &mkp MCLK  &trans     &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &trans
&trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK     &kp SLASH     &kp PAGE_DOWN  &mkp LCLK  &mkp RCLK  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp HOME
&trans  &kp N7        &kp N8        &kp N9        &kp EXCLAMATION  &kp QUESTION  &trans         &trans     &kp K_CUT  &kp K_COPY            &kp K_PASTE           &trans     &kp UP  &kp END
&trans  &kp COMMA     &kp PERIOD    &kp NUMBER_0  &trans           &trans        &trans         &trans     &trans     &kp LEFT_ARROW        &kp DOWN_ARROW        &kp RIGHT
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp N1    &kp N2  &kp N3    &kp N4      &kp N5     &kp N6     &kp N7         &kp N8     &kp N9                &kp N0                 &kp DELETE
&trans      &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT  &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans      &trans    &trans  &trans    &trans      &trans     &trans     &trans         &kp TILDE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SLASH
&trans      &trans    &trans  &trans    &trans      &trans     &trans     &trans         &trans     &trans                &trans                 &trans
            >;
        };

        layer_3 {
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp FSLH  &kp ASTRK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &trans    &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &trans    &kp END    &trans           &kp GRAVE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans          &trans    &trans     &kp KP_NUMBER_0  &kp DOT          &kp EQUAL
            >;
        };
    };
};
